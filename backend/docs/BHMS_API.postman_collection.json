{
  "info": {
    "name": "BHMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Tenant\",\n  \"email\": \"newtenant@bhms.test\",\n  \"phone\": \"09170001111\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"role\": \"tenant\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"landlord@bhms.test\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/logout"
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        { "name": "Search", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/rooms?location=Manila&min_price=3000&max_price=10000&amenity=WiFi" } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"room_number\": \"401\",\n  \"title\": \"New Studio\",\n  \"type\": \"Studio\",\n  \"location\": \"Makati\",\n  \"price\": 11000,\n  \"amenities\": [\"WiFi\", \"Aircon\"]\n}" }, "url": "{{baseUrl}}/rooms" } }
      ]
    },
    {
      "name": "Inquiries and leases",
      "item": [
        { "name": "My inquiries", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/inquiries" } },
        { "name": "Approve inquiry", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/inquiries/1/approve" } },
        { "name": "Reject inquiry", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/inquiries/1/reject" } },
        { "name": "End lease", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/leases/1/end" } },
        { "name": "Add charge", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"category\": \"CANTEEN\",\n  \"description\": \"Lunch\",\n  \"amount\": 85.50\n}" }, "url": "{{baseUrl}}/leases/1/charges" } }
      ]
    },
    {
      "name": "Billing",
      "item": [
        { "name": "Invoices", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/invoices" } },
        { "name": "Record payment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"amount\": 5000,\n  \"method\": \"cash\"\n}" }, "url": "{{baseUrl}}/invoices/1/payments" } }
      ]
    },
    {
      "name": "Dashboard and admin",
      "item": [
        { "name": "Landlord dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/landlord/dashboard" } },
        { "name": "Users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/users" } },
        { "name": "Activity logs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/activity-logs" } }
      ]
    }
  ]
}
